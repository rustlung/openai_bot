# ============================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# БАЗОВЫЕ НАСТРОЙКИ
# ============================================
# Модель OpenAI для текста (по умолчанию: gpt-4)
OPENAI_MODEL=gpt-4

# Количество пар сообщений в памяти (по умолчанию: 5)
HISTORY_PAIRS_LIMIT=5

# Путь к файлу памяти (по умолчанию: data/memory.json)
MEMORY_FILE_PATH=data/memory.json

# ============================================
# BILLING: ЦЕНЫ НА ТЕКСТ (USD за 1M токенов)
# ============================================
# Цена входных токенов (по умолчанию: 2.50 для GPT-4o)
PRICE_TEXT_INPUT_USD_PER_1M=2.50

# Цена выходных токенов (по умолчанию: 10.00 для GPT-4o)
PRICE_TEXT_OUTPUT_USD_PER_1M=10.00

# ============================================
# КУРС ВАЛЮТ (FX)
# ============================================
# API для получения курса (по умолчанию: Frankfurter/ECB)
FX_API_URL=https://api.frankfurter.app/latest?from=USD&to=RUB

# Путь к файлу кеша курса
FX_CACHE_FILE_PATH=data/fx_cache.json

# TTL кеша в секундах (по умолчанию: 21600 = 6 часов)
FX_CACHE_TTL_SECONDS=21600

# Fallback курс если API недоступен
USD_RUB_RATE=75.92

# ============================================
# ОТОБРАЖЕНИЕ СТОИМОСТИ
# ============================================
# Показывать стоимость в каждом ответе (0/1, по умолчанию: 0)
SHOW_COST_EACH_REPLY=0

# ============================================
# ГЕНЕРАЦИЯ ИЗОБРАЖЕНИЙ
# ============================================
# Модель для изображений (по умолчанию: gpt-image-1)
IMAGE_MODEL=gpt-image-1

# Размер изображения (по умолчанию: 1024x1024)
IMAGE_SIZE=1024x1024

# Цены за изображение по размерам (USD)
IMAGE_COST_USD_1024x1024=0.011
IMAGE_COST_USD_1024x1536=0.016
IMAGE_COST_USD_1536x1024=0.016
IMAGE_COST_USD_DEFAULT=0.011

# ============================================
# ГЕНЕРАЦИЯ ВИДЕО
# ============================================
# Модель для видео (по умолчанию: sora)
VIDEO_MODEL=sora

# Длительность видео в секундах (по умолчанию: 5)
VIDEO_SECONDS=5

# Размер видео (по умолчанию: 1080x1920)
VIDEO_SIZE=1080x1920

# Стоимость за секунду видео (USD)
VIDEO_COST_USD_PER_SECOND=0.20

# Интервал polling статуса видео (секунды)
VIDEO_POLL_INTERVAL_SECONDS=3

# Максимальное время ожидания генерации видео (секунды)
VIDEO_MAX_WAIT_SECONDS=180

# ============================================
# DEBUG
# ============================================
# Сохранять медиафайлы в data/tmp/ (0/1, по умолчанию: 0)
DEBUG_KEEP_MEDIA=0
